PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/trendsduniya
# Optional DNS resolvers for MongoDB Atlas in restricted local networks.
MONGODB_DNS_SERVERS=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
SITE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Production needs explicit domain URLs, MongoDB and independent JWT secrets.
# Generate each independently with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AI_ENCRYPTION_KEY=
CRON_SECRET=
AI_TIMEOUT_MS=240000
AI_GENERATION_LIMIT=10
TREND_REFRESH_HOURS=24
# Optional comma-separated trusted HTTPS hostnames for custom AI providers.
# Only add hosts you control or explicitly trust to receive your provider key.
AI_CUSTOM_HOSTS=
