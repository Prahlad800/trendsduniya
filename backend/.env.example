PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/trendsduniya
# Optional DNS resolvers for MongoDB Atlas in restricted local networks.
MONGODB_DNS_SERVERS=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
SITE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Production needs explicit domain URLs, MongoDB and independent JWT secrets.
# Generate each independently with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
AI_TIMEOUT_MS=240000
AI_GENERATION_LIMIT=10
AI_IMAGE_DAILY_LIMIT=50
TREND_REFRESH_HOURS=24

# Shared server-side text model for drafting, trends and automation
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_COMPLETION_TOKENS=4096
CLOUDFLARE_ACCOUNT_ID=77ac9f19af653236b78f84e4ea547ba0

CLOUDFLARE_API_TOKEN=
# Cloudinary credentials above are also used for generated images.
